  --path <file.sh>   one .sh file inside this repo (repeatable)
  --glob <pattern>   every .sh file the pattern matches (quote it)

example:
  rhx chmodsafe --glob 'src/domain.roles/mechanic/skills/git.pull.watch/*.sh'
"
`;

