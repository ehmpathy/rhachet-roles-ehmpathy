// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`pretooluse.forbid-cross-repo-access.sh given: [case3] Grep and Glob into a peer repo when: [t0] Grep carries a cross-repo path then: blocks it 1`] = `
"
🛑 BLOCKED: adhoc cross-repo access — Grep

   path: <gitroot>/testorg/peer-repo
   repo: testorg/peer-repo (not your current repo)

   why: that clone holds whatever is checked out there right now —
        a stale branch or a dirty tree. a direct read is a trap.

🥥 did you know?
   ├─ --tree reads a local tree's inflight state — a worktree, or the repo's own clone
   ├─ rhx git.repo.get lines --in testorg/peer-repo --words 'hello'   # latest (origin/main)
   └─ rhx git.repo.get lines --in testorg/peer-repo --tree main --words 'hello'   # inflight (uncommitted included)

"
`;

exports[`pretooluse.forbid-cross-repo-access.sh given: [case3] Grep and Glob into a peer repo when: [t1] Glob carries a cross-repo path then: blocks it 1`] = `
"
🛑 BLOCKED: adhoc cross-repo access — Glob

   path: <gitroot>/testorg/peer-repo
