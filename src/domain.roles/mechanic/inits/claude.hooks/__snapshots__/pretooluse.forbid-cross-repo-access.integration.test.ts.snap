   ├─ rhx git.repo.get files --in testorg/peer-repo --paths '**/*.ts'   # latest (origin/main)
   └─ rhx git.repo.get files --in testorg/peer-repo --tree main --paths '**/*.ts'   # inflight (uncommitted included)

"
`;

exports[`pretooluse.forbid-cross-repo-access.sh given: [case7] a WORKTREE of a peer repo when: [t0] the path is under <org>/_worktrees/<repo>.<slug> then: blocks it AND derives the true repo slug (not _worktrees) 1`] = `
