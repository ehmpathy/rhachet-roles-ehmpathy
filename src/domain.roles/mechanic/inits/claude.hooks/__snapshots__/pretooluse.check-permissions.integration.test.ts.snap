exports[`pretooluse.check-permissions.sh given: [case39] the hook edges: timeout, flags, a clock that stepped back, a bare assignment when: [t1] the hook is asked for --help then: it prints usage with every flag and exits 0 1`] = `
"
check-permissions — PreToolUse hook that nudges a blocked command toward the paved one

usage:
  pretooluse.check-permissions.sh [--mode HARDNUDGE|SOFTNUDGE|LOOKUP] [--window <seconds>]
  (reads the claude code PreToolUse payload on stdin)

flags:
  --mode HARDNUDGE   block the first attempt (exit 2); a retry within the window
                     goes to the human via permissionDecision "ask"   (default)
  --mode SOFTNUDGE   print the nudge on stdout and exit 0; never block, never record
  --mode LOOKUP      print the verdict and every candidate (no cap); exit 0, never record
                     (the engine behind \`rhx permissions.get --for\`)
  --window <n>       seconds within which a retry counts                (default: 60)
  --help, -h         print this usage

example:
  echo '{"tool_name":"Bash","tool_input":{"command":"ls src"}}' | pretooluse.check-permissions.sh

"
`;

