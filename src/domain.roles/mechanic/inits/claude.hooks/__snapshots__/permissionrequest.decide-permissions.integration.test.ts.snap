exports[`permissionrequest.decide-permissions.sh given: [case11] the audit-log path is shared, not drifted when: [t1] the SessionStart banner renders its auto-decide section then: the human-faced auto-decide explanation is snapshot-pinned (the seam promise the human reads) 1`] = `
"🐚 auto-decided permission prompts (PermissionRequest hook)
   │
   │  suspicious-classified prompts are auto-decided in-hook, per-segment:
   │
   ├─ a single clean-rhx-or-allowlisted call, not deny-listed -> auto-approved
   ├─ an all-safe-segments compound (| && || ;), no segment
   │  deny-listed: each producer is clean-rhx-or-allowlisted,
   │  each pipe sink is clean-rhx or a read-only reader
   │  (jq/tail/head/wc/cat)                                   -> auto-approved
   ├─ a background (&) or newline-joined command              -> auto-denied
   ├─ an unquoted chain with an un-vetted segment             -> auto-denied
   ├─ a deny-listed segment (piped/standalone)                -> lifted
   ├─ a deny-listed segment (chained)                         -> auto-denied
   └─ an otherwise-unprovable segment                         -> lifted to the human

🐚 every auto allow/deny is recorded to a G3 audit trail
   └─ to review why a command was auto-decided (verdict + reason + command):
         jq . .claude/permission.decisions.local.log

"
`;

exports[`permissionrequest.decide-permissions.sh given: [case11] the audit-log path is shared, not drifted when: [t1] the SessionStart banner renders its auto-decide section then: the static preamble is snapshot-pinned too (mascot + section title + legend + footer) 1`] = `
"
🐢 shell yeah, your guardrails are set 🌊

🐚 pre-approved bash permissions
   │
   │  these bash commands run without a permission prompt.
   │  ([e] = exact match · [p] = prefix match — any command that starts with it)
   │
   ├─ [p]: rhx
   │
   └─ a bash command NOT on this list blocks and asks you to reconsider —
      check this list first, to minimize interruptions.

"
`;
