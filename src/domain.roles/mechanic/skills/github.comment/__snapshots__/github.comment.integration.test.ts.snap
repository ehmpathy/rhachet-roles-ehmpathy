exports[`github.comment given: [case11] every verb checks its input before any gh call, and shows --help when: [t1] get, set, del each get --help then: each exits 0 with usage, inputs, an example; calls no gh 1`] = `
{
  "del": "🐢 heres the wave...

🐚 github.comment.del — delete one comment of a pull request; a no-op if absent
   ├─ usage: rhx github.comment.del --pr <n> (--id <id> --kind issue|review | --key <k> [--reply-to <id>]) [--mode plan|apply]
   ├─ inputs
   │  ├─ --pr <n>                      required
   │  ├─ --key <k> [--reply-to <id>]   the current login's keyed comment (in that thread, with --reply-to)
   │  ├─ --id <id> --kind <kind>       one comment, by id; kind = issue | review, never guessed
   │  ├─ --in <owner/name>             default: the cwd's github origin; home orgs only (ehmpathy whodisio ahbode uladkasach)
   │  ├─ --auth                        as-ehmpath (default; the env token, else the keyrack) | as-human
   │  ├─ --mode                        plan (default, no write) | apply (delete, then confirm absent)
   │  └─ --output                      tree (default) | json
   ├─ example: rhx github.comment.del --pr 69 --key status --mode apply
   └─ exit: 0 planned, deleted, or no-op; 1 malfunction; 2 constraint
",
  "get": "🐢 heres the wave...

🐚 github.comment.get — read the comments of a pull request
   ├─ usage: rhx github.comment.get --pr <n> [--id <id> --kind issue|review | --key <k> [--reply-to <id>] | --kind body] [--in <o/r>] [--auth as-ehmpath|as-human] [--output tree|json]
   ├─ inputs
   │  ├─ --pr <n>                      required
   │  ├─ --id <id> --kind <kind>       one comment, by id; kind = issue | review, never guessed
   │  ├─ --key <k> [--reply-to <id>]   the current login's keyed comment (in that thread, with --reply-to)
   │  ├─ --kind body                   the pr description alone
   │  ├─ --in <owner/name>             default: the cwd's github origin; home orgs only (ehmpathy whodisio ahbode uladkasach)
   │  ├─ --auth                        as-ehmpath (default; the env token, else the keyrack) | as-human
   │  └─ --output                      tree (default) | json
   ├─ example: rhx github.comment.get --pr 69
   └─ exit: 0 shown; 1 malfunction; 2 constraint (bad input or absent target)
",
  "set": "🐢 heres the wave...

🐚 github.comment.set — upsert one comment of a pull request, or its description
   ├─ usage: rhx github.comment.set --pr <n> (--key <k> [--reply-to <id>] | --id <id> --kind issue|review | --kind body) --from <path|@stdin> [--mode plan|apply]
   ├─ targets
   │  ├─ --key <k>                     top-level comment: absent → POST, differs → PATCH, same → no-op
   │  ├─ --reply-to <id> --key <k>     a reply in that review thread, same upsert
   │  ├─ --id <id> --kind <kind>       edit a known comment; kind = issue | review
   │  └─ --kind body                   the pr description
   ├─ inputs
   │  ├─ --pr <n>                      required
   │  ├─ --from <path|@stdin>          the body; posted as '🐢 ' + body (+ a hidden key marker)
   │  ├─ --in <owner/name>             default: the cwd's github origin; home orgs only (ehmpathy whodisio ahbode uladkasach)
   │  ├─ --auth                        as-ehmpath (default; the env token, else the keyrack) | as-human
   │  ├─ --mode                        plan (default, no write) | apply (write, read back, hash-check)
   │  └─ --output                      tree (default) | json
   ├─ example: rhx github.comment.set --pr 69 --key status --from ./status.md --mode apply
   └─ exit: 0 planned, written, or no-op; 1 malfunction; 2 constraint
",
}
`;

