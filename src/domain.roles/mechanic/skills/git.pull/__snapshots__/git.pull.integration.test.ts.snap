exports[`git.pull given: [case1] the branch has no open pull when: [t0] each of the four verbs runs then: each exits 2, names the branch and the fix, writes naught 1`] = `
"✋ ConstraintError: --pr is absent, and branch 'surf/no-pull-here' has no open pull on ehmpathy/surf-demo

🥥 did you know?
   └─ to fix it, pick one
      ├─ rhx git.commit.push --mode apply   # if this branch has no pull yet, a push opens one
      └─ rhx git.pull.title.set --pr <n> ...   # or name a pull, closed or merged included
"
`;

exports[`git.pull given: [case2] the credential is unusable when: [t0] the keyrack holds no token then: each exits 2, names the keyrack fix, and calls no gh 1`] = `
"✋ ConstraintError: ehmpath keyrack token not available
   └─ cause: credential not found: EHMPATHY_SEATURTLE_GITHUB_TOKEN

🥥 did you know?
   └─ to fix it, by the state of the token, pick one
      ├─ rhx keyrack fill --owner ehmpath --env prep --key EHMPATHY_SEATURTLE_GITHUB_TOKEN   # a human, where the token was never set
      ├─ rhx keyrack unlock --owner ehmpath --env prep --key EHMPATHY_SEATURTLE_GITHUB_TOKEN   # the token is set, but locked
      └─ rerun with --auth as-human   # post under your own gh login instead
"
`;

exports[`git.pull given: [case2] the credential is unusable when: [t1] as-human, with gh logged out then: each exits 2, names gh auth login, and writes naught 1`] = `
"✋ ConstraintError: github refused the credential (as-human) on the read of the current login
   └─ detail: To get started with GitHub CLI, please run:  gh auth login

🥥 did you know?
   └─ to fix it
      └─ gh auth login
"
`;

