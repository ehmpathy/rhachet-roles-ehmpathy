exports[`git.pull given: [case6] the less-trod contract paths of each noun when: [t2] each dispatcher runs with no verb then: each exits 2 and names the verbs 1`] = `
"✋ ConstraintError: a verb is required; the verbs are get | set

🥥 did you know?
   └─ to fix it
      └─ rhx git.pull.title get --help
"
`;

exports[`git.pull given: [case6] the less-trod contract paths of each noun when: [t3] each get and each noun shows its --help then: each get help names every flag 1`] = `
"usage: git.pull.title.get [--pr <n>] [--in <owner/name>] [--auth as-ehmpath|as-human] [--output tree|json|text]

options:
  --pr <n>                     the pull request (default: the open pull of the cwd branch)
  --in <owner/name>            the repo (default: the cwd's github origin); a home org only
  --auth as-ehmpath|as-human   who reads (default: as-ehmpath)
  --output tree|json|text      the output shape (default: tree); text = the title alone.
                               via rhx, stdout opens with rhx's header line, so read the
                               last line, never the whole stream
  --help, -h                   show this help

example:
  rhx git.pull.title get --pr 69
"
`;

exports[`git.pull given: [case6] the less-trod contract paths of each noun when: [t3] each get and each noun shows its --help then: each get help names every flag 2`] = `
"usage: git.pull.description.get [--pr <n>] [--in <owner/name>] [--auth as-ehmpath|as-human] [--output tree|json|text] [--to <path>]

options:
  --pr <n>                     the pull request (default: the open pull of the cwd branch)
  --in <owner/name>            the repo (default: the cwd's github origin); a home org only
  --auth as-ehmpath|as-human   who reads (default: as-ehmpath)
  --output tree|json|text      the output shape (default: tree); text = the body alone.
                               via rhx, stdout opens with rhx's header line; to edit, use --to
  --to <path>                  also write the bare body to <path>, to edit, then set --from <path>
  --help, -h                   show this help

example:
  rhx git.pull.description get --to ./.temp/body.md
  rhx git.pull.description set --from ./.temp/body.md
"
`;

exports[`git.pull given: [case6] the less-trod contract paths of each noun when: [t3] each get and each noun shows its --help then: each noun help names both verbs 1`] = `
"usage: git.pull.title <get | set> [flags]

verbs:
  get                          rhx git.pull.title get --help, for its flags
  set                          rhx git.pull.title set --help, for its flags

options:
  --help, -h                   show this help
"
`;

