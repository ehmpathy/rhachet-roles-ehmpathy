exports[`git.pull given: [case1b] each verb refuses bad input before any gh call when: [t9] each verb takes its flags in the --flag=value form then: each parses the = form as the spaced form, and writes naught 1`] = `
{
  "descriptionSet": "🐢 heres the wave...

🐚 git.pull.description.set --mode plan
   ├─ target: ehmpathy/surf-demo#7, description
   ├─ auth: as-ehmpath (ehmpath keyrack) as ehm-seaturtle
   ├─ author: ehm-seaturtle
   ├─ state: open
   ├─ url: https://github.com/ehmpathy/surf-demo/pull/7
   ├─ current
   │  ├─ bytes: 60
   │  ├─ sha256: 8dd56989cf25f4c296bf9f61a99a274f8db7ad0e160a57ae725a029926677c28
   │  └─ text
   │     surf lesson booker
   │
   │     ---
   │     🐢🌊 surfed in by seaturtle[bot]
   │
   ├─ new
   │  ├─ from: ./.temp/kelp.md
   │  ├─ repair: appended the seaturtle footer
   │  ├─ bytes: 63
   │  ├─ sha256: 5117ad55c3303af0b47847626bb244efab635d2629da1e512c1e438785f73ade
   │  └─ text
   │     kelp bed map, by tide
   │
   │     ---
   │     🐢🌊 surfed in by seaturtle[bot]
   │
   └─ verdict: would set (plan)

🥥 did you know?
   └─ plan writes naught; to write it
      └─ rhx git.pull.description.set --pr=7 --from=./.temp/kelp.md --mode apply
",
  "titleSet": "🐢 heres the wave...

🐚 git.pull.title.set --mode plan
   ├─ target: ehmpathy/surf-demo#7, title
   ├─ auth: as-ehmpath (ehmpath keyrack) as ehm-seaturtle
   ├─ author: ehm-seaturtle
   ├─ state: open
   ├─ url: https://github.com/ehmpathy/surf-demo/pull/7
   ├─ current: feat(lessons): book a surf lesson
   ├─ new: feat(reef): map the kelp beds
   └─ verdict: would set (plan)

🥥 did you know?
   └─ plan writes naught; to write it
      └─ rhx git.pull.title.set --pr=7 '--title=feat(reef): map the kelp beds' --mode apply
",
}
`;

exports[`git.pull given: [case2] the credential is unusable when: [t0] the keyrack holds no token then: each exits 2, names the keyrack fix, and calls no gh 1`] = `
"✋ ConstraintError: ehmpath keyrack token not available
   └─ cause: credential not found: EHMPATHY_SEATURTLE_GITHUB_TOKEN

🥥 did you know?
   └─ to fix it, by the state of the token, pick one
      ├─ rhx keyrack fill --owner ehmpath --env prep --key EHMPATHY_SEATURTLE_GITHUB_TOKEN   # a human, where the token was never set
      ├─ rhx keyrack unlock --owner ehmpath --env prep --key EHMPATHY_SEATURTLE_GITHUB_TOKEN   # the token is set, but locked
      └─ rerun with --auth as-human   # act under your own gh login instead
"
`;

