// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`permissions.get.sh given: [case1] a repo with an allowlist in both settings files when: [t0] the bot runs the bare skill then: the render matches snapshot 1`] = `
"🐢 heres the wave...

🐚 permissions.get
   ├─ sources
   │  ├─ .claude/settings.json (10)
   │  └─ .claude/settings.local.json (2)
   ├─ total: 11 pre-approved (dupes removed)
   │
   ├─ cat (1)
   │  └─ [p] cat
   │
   ├─ git (6)
   │  ├─ [p] git blame
   │  ├─ [p] git diff
   │  ├─ [p] git log
   │  ├─ [p] git ls-files
   │  ├─ [p] git show
   │  └─ … 1 more: rhx permissions.get --head git
   │
   ├─ jq (1)
   │  └─ [e] jq
   │
   ├─ npm (1)
   │  └─ [p] npm run build
   │
   ├─ rhx (1)
   │  └─ [p] rhx
   │
   ├─ tree (1)
   │  └─ [p] tree
   │
   └─ key: [e] = the whole part must match exactly · [p] = the part must start with it

🥥 did you know?
   ├─ narrow to one head: rhx permissions.get --head <head>
   └─ check one exact command: rhx permissions.get --for '<command>'

"
`;

