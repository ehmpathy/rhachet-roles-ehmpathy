exports[`git.pull.watch delivery given: [case16] calls the skill refuses (entries E7, E3) when: [t6] the dispatcher is called: help, and a verb then: help names each verb and an example 1`] = `
"usage: git.pull.watch <get | set | del> [flags]

verbs:
  get                          the daemons on this machine and their watches
  set --pr <n>                 watch a pr from this clone (plan by default)
  del --pr <n>                 stop this clone's watch on a pr (plan by default)

options:
  --help, -h                   show this help; rhx git.pull.watch <verb> --help for a verb's flags

example:
  rhx git.pull.watch set --pr 1220 --mode apply
"
`;

