exports[`git.pull.watch delivery given: [case16] calls the skill refuses (entries E7, E3) when: [t4] help is asked of each verb then: each exits 0 with usage, options, and an example 2`] = `
"usage: git.pull.watch.set --pr <n> [--in <owner/name>] [--mode plan|apply] [--output tree|json]

options:
  --pr <n>            the pull request to watch (required)
  --in <owner/name>   the repo (default: the cwd's github origin)
  --mode plan|apply   plan shows what would happen; apply watches (default: plan)
  --output tree|json  the output shape (default: tree)
  --help, -h          show this help

example:
  rhx git.pull.watch.set --pr 1220 --mode apply
"
`;

exports[`git.pull.watch delivery given: [case16] calls the skill refuses (entries E7, E3) when: [t4] help is asked of each verb then: each exits 0 with usage, options, and an example 3`] = `
"usage: git.pull.watch.del --pr <n> [--in <owner/name>] [--mode plan|apply] [--output tree|json]

options:
  --pr <n>            the pull request to stop the watch of (required)
  --in <owner/name>   the repo (default: the cwd's github origin)
  --mode plan|apply   plan shows what would happen; apply deletes (default: plan)
  --output tree|json  the output shape (default: tree)
  --help, -h          show this help

example:
  rhx git.pull.watch.del --pr 1220 --mode apply
"
`;

