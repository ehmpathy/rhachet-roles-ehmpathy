exports[`git.repo.test.sh grove given: [case3] a grove with 1 slot, held by a skill run (wish clamp 2) when: [t8] the holder is sent SIGTERM and each kill of its tree is refused then: the stop render matches snapshot 1`] = `
"🐚 git.repo.test --what unit --mode apply
   ├─ 💥 MalfunctionError: could not stop the test tree
   │  ├─ target: <target> (TERM)
   │  ├─ cause: bash: kill: (<target>) - Operation not permitted
   │  └─ fix: kill -TERM -- <target>
   ├─ 💥 MalfunctionError: could not stop the test tree
   │  ├─ target: <target> (KILL)
   │  ├─ cause: bash: kill: (<target>) - Operation not permitted
   │  └─ fix: kill -KILL -- <target>
   └─ 🌙 stopped by sigterm; the test tree may still run, run the kill -KILL fix above (exit 143)"
`;

