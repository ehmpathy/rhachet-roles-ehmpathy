exports[`git.repo.test.sh bound given: [case11] a fuse that cannot run the suite when: [t0] the skill runs a suite through it then: stderr matches snapshot 1`] = `
"🐢 bummer dude...

🐚 git.repo.test --what lint
   ├─ bound: 420s (default)
   │  └─ let your shell call run past 450s, or its own clock ends this run first
   ├─ status
   │  └─ 💥 malfunction (Xs)
   └─ log: .log/role=mechanic/skill=git.repo.test/what=lint/ISOTIME.stderr.log

