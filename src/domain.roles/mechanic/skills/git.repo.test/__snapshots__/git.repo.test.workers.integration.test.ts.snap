exports[`git.repo.test.sh workers given: [case12] a run that exceeds its --timeout when: [t0] the run was capped then: stderr carries the same hint, and matches snapshot 1`] = `
"🐢 bummer dude...

🐚 git.repo.test --what unit --mode apply --thorough
   │  └─ ⏱️ timeout (Xs)
   ├─ status: malfunction
   ├─ error: test exceeded 1s timeout
   └─ log
      ├─ stdout: .log/role=mechanic/skill=git.repo.test/what=unit/__isotime__.stdout.log
      └─ stderr: .log/role=mechanic/skill=git.repo.test/what=unit/__isotime__.stderr.log

hint: increase --timeout or check for slow tests

🥥 did you know?
   ├─ this run was capped at 4 jest workers (shared box)
   └─ on an idle box, widen it
      └─ rhx git.repo.test --what unit --mode apply --thorough -- --maxWorkers=8"
`;

