exports[`git.branch.uses given: [case10] a human asks for help when: [t0] --help then: it teaches every command, with a copy-paste example 1`] = `
"usage: git.branch.uses set --quant N
       git.branch.uses del
       git.branch.uses block         (alias for del)
       git.branch.uses allow         (unlimited)
       git.branch.uses get
       git.branch.uses --global block|allow|get
       git.branch.uses --org <org> allow|block|del|get

commands:
  set    grant cutover quota (human only)
  del    revoke quota (shortcut for set --quant 0)
  block  alias for del
  allow  grant unlimited quota (human only)
  get    check quota left

options (set):
  --quant N             cutovers to allow (or 'infinite')

options:
  --help, -h            show this help

examples:
  rhx git.branch.uses get                    # how many cutovers are left
  rhx git.branch.uses set --quant 3          # grant 3 cutovers in this repo (human)
  rhx git.branch.uses --global block         # pause cutovers in every repo
"
`;

