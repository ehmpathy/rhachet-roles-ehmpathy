exports[`git.stage.add.sh given: [case10] the local commit quota file is damaged when: [t0] stage reads a truncated quota file then: malfunction: names the file, fails closed, stages naught 1`] = `
"🐢 bummer dude...

🐚 git.stage.add
   └─ 💥 MalfunctionError: commit quota file corrupt

   the file that holds this tree's commit quota cannot be read:
     .meter/git.commit.uses.jsonc

🥥 did you know?
   ├─ ask your human to reset the quota, then grant again
   ├─ git.commit.uses del
   └─ git.commit.uses set --quant N
"
`;

exports[`git.stage.add.sh given: [case11] --help when: [t0] help is asked for then: names the grant constraints, matches snapshot 1`] = `
"usage: git.stage.add path1 path2 ...    # stage specific files
       git.stage.add src/**/*.ts        # stage via shell glob
       git.stage.add .                  # stage all in current dir

options:
  --help, -h    show this help

constraints:
  - out of a rebase, requires a live commit grant (git.commit.uses set --quant N)
  - mid-rebase, reads no meter
  - paths must be within repo
"
`;
