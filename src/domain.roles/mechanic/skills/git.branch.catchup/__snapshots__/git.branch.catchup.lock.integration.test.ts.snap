exports[`git.branch.catchup lock refresh given: [case26c] a hand merge of another branch in flight when: [t0] lock refresh then: matches snapshot: under the lock refresh header 1`] = `
"✋ ConstraintError: the merge in flight is not a catch-up from origin/main

🐚 git.branch.catchup lock refresh
   ├─ MERGE_HEAD: HASH123 (not on origin/main)
   ├─ why: this verb commits only a merge of origin/main
   └─ fix: back it out with rhx git.branch.catchup abort, then begin
"
`;

exports[`git.branch.catchup lock refresh given: [case26c] a merge in flight, in a repo with no lockfile when: [t0] lock refresh then: matches snapshot 1`] = `
