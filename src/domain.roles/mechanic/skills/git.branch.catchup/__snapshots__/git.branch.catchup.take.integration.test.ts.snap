`;

exports[`git.branch.catchup take given: [case23c] conflicts on two files where one name holds the other when: [t0] take --whos main 'x y.txt' x then: matches snapshot: the spaced name renders whole 1`] = `
"🐢 righteous!

🐚 git.branch.catchup take
   ├─ whos: main
   ├─ settled
   │  ├─ x ✓
   │  └─ x y.txt ✓
   └─ next: rhx git.branch.catchup continue
"
`;

exports[`git.branch.catchup take given: [case23d] a conflict left, and stage is blocked when: [t0] take --whos main src/a.md then: matches snapshot 1`] = `
"🐢 righteous!

🐚 git.branch.catchup take
   ├─ whos: main
   ├─ settled
   │  └─ src/a.md ✓
   ├─ still in conflict
   │  └─ src/b.md
   └─ next
      ├─ remove the <<<<<<< ======= >>>>>>> lines from each file
      ├─ settle the rest:   a human grants stage first
      │  └─ a human runs: rhx git.commit.uses set --quant N --push allow --stage allow
      ├─ or take a side:    rhx git.branch.catchup take --whos <main|branch> <file>
      └─ then:              rhx git.branch.catchup continue
"
`;

exports[`git.branch.catchup take given: [case23e] take run from a subdirectory when: [t0] take --whos main . from src/ then: matches snapshot 1`] = `
