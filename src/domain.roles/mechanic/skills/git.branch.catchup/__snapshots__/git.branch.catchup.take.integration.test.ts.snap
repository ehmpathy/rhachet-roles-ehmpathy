// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`git.branch.catchup take given: [case23] a merge in flight with two text conflicts when: [t0] take --whos main src/a.md then: matches snapshot 1`] = `
"🐢 righteous!

🐚 git.branch.catchup take
   ├─ whos: main
   ├─ settled
   │  └─ src/a.md ✓
   ├─ still in conflict
   │  └─ src/b.md
   └─ next
      ├─ remove the <<<<<<< ======= >>>>>>> lines from each file
      ├─ settle the rest:   rhx git.stage.add <file>
      ├─ or take a side:    rhx git.branch.catchup take --whos <main|branch> <file>
      └─ then:              rhx git.branch.catchup continue
"
`;

exports[`git.branch.catchup take given: [case23] a merge in flight with two text conflicts when: [t1] take --whos branch src/b.md then: matches snapshot 1`] = `
"🐢 righteous!

🐚 git.branch.catchup take
   ├─ whos: branch
   ├─ settled
   │  └─ src/b.md ✓
   └─ next: rhx git.branch.catchup continue
"
`;

exports[`git.branch.catchup take given: [case23] a merge in flight with two text conflicts when: [t2] take again, with no file left in conflict then: matches snapshot 1`] = `
"✋ ConstraintError: no file in conflict

🐚 git.branch.catchup take
   └─ next: rhx git.branch.catchup continue
"
`;

exports[`git.branch.catchup take given: [case23b] a path that matches no conflicted file when: [t0] take --whos main src/a.md src/absent.md then: matches snapshot 1`] = `
"✋ ConstraintError: a path matches no conflicted file

🐚 git.branch.catchup take
   ├─ unmatched
   │  └─ src/absent.md
   ├─ note: paths are read from the repo root, wherever take runs
   └─ in conflict
      ├─ src/a.md
      └─ src/b.md
"
`;

exports[`git.branch.catchup take given: [case23b] a path that matches no conflicted file when: [t1] take --whos ours src/a.md then: matches snapshot 1`] = `
"✋ ConstraintError: --whos must be main or branch (got: ours)

🐚 git.branch.catchup take
   ├─ main     origin/main's version of the file
   ├─ branch   this branch's version of the file
   └─ usage: rhx git.branch.catchup take --whos <main|branch> <paths…>
"
`;

exports[`git.branch.catchup take given: [case23b] a path that matches no conflicted file when: [t2] take --whos main, with no path then: matches snapshot 1`] = `
"✋ ConstraintError: no paths given

🐚 git.branch.catchup take
   └─ usage: rhx git.branch.catchup take --whos <main|branch> <paths…>
"
`;

exports[`git.branch.catchup take given: [case23b] a path that matches no conflicted file when: [t3] take with an unknown flag then: matches snapshot 1`] = `
"✋ ConstraintError: unknown argument: --force

🐚 git.branch.catchup take
