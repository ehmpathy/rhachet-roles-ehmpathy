exports[`git.branch.catchup given: [case29] a feature branch when: [t3] --help on each subcommand then: matches snapshot 1`] = `
"$ begin --help
🐢 heres the wave...

🐚 git.branch.catchup begin
   ├─ catch up via merge (no rewrite) from origin/main
   ├─ usage
   │  └─ rhx git.branch.catchup begin [--mode plan|apply]
   ├─ options
   │  ├─ --mode plan    preview the merge (default)
   │  └─ --mode apply   merge and commit
   └─ examples
      ├─ rhx git.branch.catchup begin
      └─ rhx git.branch.catchup begin --mode apply

$ take --help
🐢 heres the wave...

🐚 git.branch.catchup take
   ├─ usage
   │  └─ rhx git.branch.catchup take --whos <main|branch> <paths…>
   ├─ args
   │  ├─ --whos   main (origin/main's version) or branch (this branch's version)
   │  └─ paths    conflicted files or globs, from the repo root; . for every conflict
   └─ examples
      ├─ rhx git.branch.catchup take --whos main pnpm-lock.yaml
      └─ rhx git.branch.catchup take --whos branch src/readme.md

$ lock --help
🐢 heres the wave...

🐚 git.branch.catchup lock
   ├─ usage
   │  └─ rhx git.branch.catchup lock refresh
   └─ refreshes the lockfile against the merged package.json, and stages it

$ continue --help
🐢 heres the wave...

🐚 git.branch.catchup continue
   ├─ catch up via merge (no rewrite) from origin/main
   ├─ usage
   │  └─ rhx git.branch.catchup continue
   └─ makes the merge commit once every conflict is settled and staged

$ abort --help
🐢 heres the wave...

🐚 git.branch.catchup abort
   ├─ usage
   │  └─ rhx git.branch.catchup abort
   └─ backs out of the merge in flight; HEAD, index, and tree return to before the merge
"
`;

exports[`git.branch.catchup given: [case29] a feature branch when: [t4] an unknown flag on each subcommand then: matches snapshot 1`] = `
"$ begin --force
✋ ConstraintError: unknown argument: --force

🐚 git.branch.catchup begin
   └─ usage: rhx git.branch.catchup begin [--mode plan|apply]

$ take --force
✋ ConstraintError: unknown argument: --force

🐚 git.branch.catchup take
   └─ usage: rhx git.branch.catchup take --whos <main|branch> <paths…>

$ lock refresh --force
✋ ConstraintError: unknown argument: --force

🐚 git.branch.catchup lock
   └─ usage: rhx git.branch.catchup lock refresh

$ continue --force
✋ ConstraintError: unknown argument: --force

🐚 git.branch.catchup continue
   └─ usage: rhx git.branch.catchup continue

$ abort --force
✋ ConstraintError: unknown argument: --force

🐚 git.branch.catchup abort
   └─ usage: rhx git.branch.catchup abort
"
`;
