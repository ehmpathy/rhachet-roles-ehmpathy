// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`git.branch.catchup continue given: [case2] a merge in flight with two conflicted files when: [t1] one file settled + staged, the other not; continue then: matches snapshot 1`] = `
"✋ ConstraintError: 1 file still in conflict

🐚 git.branch.catchup continue
   ├─ conflicts
   │  └─ src/b.md
   └─ next
      ├─ remove the <<<<<<< ======= >>>>>>> lines from each file
      ├─ settle each file:  rhx git.stage.add <file>
      ├─ or take a side:    rhx git.branch.catchup take --whos <main|branch> <file>
      ├─ then:              rhx git.branch.catchup continue
      └─ or back out:       rhx git.branch.catchup abort
"
`;

exports[`git.branch.catchup continue given: [case2] a merge in flight with two conflicted files when: [t2] every file settled and staged, then continue then: matches snapshot 1`] = `
"🐢 righteous!

🐚 git.branch.catchup continue
   ├─ merge
   │  ├─ from: origin/main
   │  ├─ files: 2 merged
   │  └─ status: committed
   ├─ commit: HASH123 cont(branch): merge origin/main into turtle/feat-wave-report
   └─ meter
      └─ left: 3

🌊 ready to push
   └─ rhx git.commit.push --mode apply
"
`;

exports[`git.branch.catchup continue given: [case27] no merge in flight when: [t0] continue then: matches snapshot 1`] = `
"✋ ConstraintError: no merge in flight

🐚 git.branch.catchup continue
   ├─ state: no catch-up merge is in flight
   └─ fix: start one with rhx git.branch.catchup begin
"
`;

exports[`git.branch.catchup continue given: [case31] a settled merge in flight, and the meter ran dry since begin when: [t0] continue then: matches snapshot 1`] = `
"🐢 bummer dude...

🐚 git.branch.catchup continue
   └─ ✋ ConstraintError: no commit uses left

ask your human to grant more:
  $ rhx git.commit.uses set --quant N --push allow
"
`;

exports[`git.branch.catchup continue given: [case32] a settled merge in flight, and a commit-msg hook that refuses when: [t0] continue then: matches snapshot 1`] = `
"💥 MalfunctionError: git commit failed; the merge stays in flight

🐚 git.branch.catchup continue
   ├─ cause
   │  ├─ commitlint: the header was refused
   │  └─ commitlint: see the commit convention
   └─ next
      ├─ fix the cause above
      ├─ then:              rhx git.branch.catchup continue
      └─ or back out:       rhx git.branch.catchup abort
"
`;

