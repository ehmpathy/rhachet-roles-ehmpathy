exports[`git.repo.get.sh given: [case20] --help flag when: [t0] --help is passed then: shows usage and exits 0 1`] = `
"usage: rhx git.repo.get <subcommand> [options]

subcommands:
  repos   list repos that match a glob
  files   list files in a repo
  lines   search or read file contents

options:
  --repos <glob>     glob pattern for repos (e.g., 'ehmpathy/*')
  --in <slug>        single repo (e.g., 'ehmpathy/domain-objects')
  --paths <glob>     filter files by path glob
  --words <pattern>  search for pattern (triggers search mode)
  --radius <N>       context lines around matches (default: 21)
  --ref <ref>        git ref to use (default: origin/main)
  --tree <name>      read a local tree's inflight state instead of
                     origin/main (uncommitted edits included).
                     names a branch or a tree dir; the repo's own
                     main clone counts as a tree too, so its branch
                     reads that clone's live disk state.
                     applies to the files and lines subcommands.
  --refresh <on|off> fetch latest before query (default: on)

examples:
  # latest committed state (the default)
  rhx git.repo.get lines --in ehmpathy/domain-objects --paths 'src/index.ts'

  # peek at inflight work in a linked worktree
  rhx git.repo.get lines --in ehmpathy/domain-objects --tree feat/new-refs --paths 'src/index.ts'

  # peek at the main clone's own live state (dirty edits included)
  rhx git.repo.get lines --in ehmpathy/domain-objects --tree main --paths 'src/index.ts'
"
`;

