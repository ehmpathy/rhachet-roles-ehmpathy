exports[`git.repo.get.sh given: [case32] --tree combined with --ref when: [t0] both source selectors are passed then: fails loud rather than silently pick one 1`] = `
"🐢 bummer dude

🐚 git.repo.get lines
   ├─ ref: origin/main
   ├─ tree: feat/inflight
   └─ error: --tree cannot be combined with --ref

🥥 did you know?
   ├─ they name two different sources, so pick one
   ├─ rhx git.repo.get lines --in <org>/<repo> --ref origin/main     # committed
   └─ rhx git.repo.get lines --in <org>/<repo> --tree feat/inflight  # inflight
"
`;

exports[`git.repo.get.sh given: [case33] --tree on the repos subcommand when: [t0] --tree is passed to a repo enumeration then: fails loud rather than silently drop it 1`] = `
"🐢 bummer dude

🐚 git.repo.get repos
   ├─ tree: feat/inflight
   └─ error: --tree has no sense on the repos subcommand

🥥 did you know?
   ├─ a worktree is a tree of one repo, so ask for its files or lines instead
   ├─ rhx git.repo.get files --in <org>/<repo> --tree feat/inflight
   └─ rhx git.repo.get lines --in <org>/<repo> --tree feat/inflight --paths '<file>'
"
`;

exports[`git.repo.get.sh given: [case34] --paths that tries to escape the worktree when: [t0] --paths walks up out of the tree with ../ then: refuses — the sanctioned tool is not a way to read the host 1`] = `
"🐢 bummer dude

🐚 git.repo.get lines
   ├─ repo: testorg/short (local)
   ├─ tree: feat/inflight
   └─ error: --paths resolves outside the worktree

   "../../../../../outside-secret.txt" walks out of the tree it was scoped to.
   git.repo.get reads repos, not the whole host filesystem.

🥥 did you know?
   ├─ give a path relative to the repo root
