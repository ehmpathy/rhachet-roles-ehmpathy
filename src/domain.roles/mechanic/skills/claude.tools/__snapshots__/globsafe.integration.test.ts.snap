exports[`globsafe.sh given: [case15] --head rejects input it cannot use when: [t4] a caller reads --help before they meet a gate then: both new refusals are documented there 1`] = `
"usage: globsafe.sh --pattern 'glob' [options]

options:
  --pattern GLOB     file pattern (required, e.g., 'src/**/*.ts');
                     repeat to match several
  --path DIR         base directory (default: .); repeat to search
                     several
  --hidden           let wildcards match dot paths (.git excluded)
  --long             show detailed file info (size, mtime)
  --head N           limit output to N files (positive integer)
  --sort ORDER       name|time|size (default: name)
  --output MODE      vibes|pipeable (default: vibes)
  --literal          treat pattern as literal (no glob expansion)
                     use when pattern contains [ or ] characters

notes:
  --head takes a positive integer of at most 18 digits; any other
    value is refused (exit 2), never reinterpreted. a wider value
    would wrap negative in bash and yield a false zero
  every --pattern and --path is searched, and the union returned.
    a bare positional root stands alone: beside another root it is
    refused (exit 2), since an unquoted glob the shell expanded
    lands there too
  a wildcard skips dot paths. when a hidden file would match, the
    output says so and names --hidden
  --output 'direct' is renamed 'pipeable'; the old value is
    refused (exit 2) with the new name

examples:
  globsafe.sh --pattern 'src/**/*.ts'                  # glob pattern
  globsafe.sh --pattern '*.[ref].md' --literal         # literal brackets
  globsafe.sh --pattern '*.\\[ref\\].md'                 # escaped brackets
"
`;

