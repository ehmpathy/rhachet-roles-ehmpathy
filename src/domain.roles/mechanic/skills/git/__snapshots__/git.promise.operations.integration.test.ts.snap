// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`git.promise.operations.sh given: [case5] the nudge when: [t0] a public repo then: it names the repo, the text to check, and the rerun 1`] = `
"🐢 hold up — this text goes to a public repo
   ├─ repo: ehmpathy/surf-demo (public)
   ├─ check the comment holds none of:
   │  ├─ a private org, repo, route path, or pr / issue numbers
   │  ├─ internal endpoint, service, table or product names
   │  └─ customer, revenue or other business detail
   └─ once checked, re-run with:
      └─ rhx git.pull.comment.set --which 7 --promise text-to-public-repo-is-anonymized
"
`;

exports[`git.promise.operations.sh given: [case5] the nudge when: [t1] an unreadable visibility, with its cause then: the repo line says held as public, and the cause sits under it 1`] = `
"🐢 hold up — this text goes to a public repo
   ├─ repo: ehmpathy/surf-demo (visibility unreadable, held as public)
   │  └─ cause: gh: Bad Gateway (HTTP 502)
   ├─ check the title holds none of:
   │  ├─ a private org, repo, route path, or pr / issue numbers
   │  ├─ internal endpoint, service, table or product names
   │  └─ customer, revenue or other business detail
   └─ once checked, re-run with:
      └─ rhx git.pull.title.set --which 7 --promise text-to-public-repo-is-anonymized
"
`;
