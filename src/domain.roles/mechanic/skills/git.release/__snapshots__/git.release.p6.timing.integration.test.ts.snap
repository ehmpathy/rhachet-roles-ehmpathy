// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`git.release.p6.timing negative: graceful fallback when timestamps absent given: [case4] already merged PR (no active checks) when: [t0] --watch is called then: it gracefully handles already merged state 1`] = `
"🐢 heres the wave...

🐚 git.release --into main --watch

🌊 release: feat(ocean): add surfboards
   ├─ 👌 all checks passed
   └─ 🌴 already merged
"
`;

exports[`git.release.p6.timing negative: graceful fallback when timestamps absent given: [case5] tag watch with grace period (no runs yet) when: [t0] --watch --into prod --from main is called with no initial runs then: it gracefully handles absent timestamps in grace period 1`] = `
"🐢 heres the wave...

🐚 git.release --into prod --watch

🌊 release: chore(release): v1.3.0
   ├─ 👌 all checks passed
   └─ 🌴 already merged

🫧 and then...

🌊 release: v1.3.0
   ├─ 🐢 1 check(s) in progress
