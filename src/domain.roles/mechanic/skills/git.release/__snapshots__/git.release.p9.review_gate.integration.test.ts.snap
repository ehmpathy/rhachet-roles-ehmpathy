exports[`git.release.p9.review_gate given: [case1] feature pr #42, checks passed, no reviews when: [t0] --into main --apply then: exit 2, names the pr, says a human approval is owed, naught merged 1`] = `
"🐢 hold up dude...

🐚 git.release --into main --mode apply --watch

🌊 release: feat(ocean): add surfboards
   ├─ ✋ ConstraintError: pr #42 has no approval from a human
   ├─ a merge needs a human's APPROVED review; a commit quota grants commits, never a merge
   └─ ask your human to review: pr #42
"
`;

