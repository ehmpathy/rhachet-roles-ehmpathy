exports[`git.release.p2 argument validation given: [case-arg-help] --help flag when: [t0] --help then: exit 0: shows usage 1`] = `
"usage: git.release [--into main|prod] [--watch] [--apply] [--mode plan|apply] [--retry] [--dirty block|allow]
       git.release --from main --into prod   # special-circumstance only

  --into prod   full release to prod (the default, safe way to ship your work)
  --into main   merge feature branch to main only (stops before prod)
  --watch       watch CI without automerge
  --apply       enable automerge and watch (alias for --mode apply)
  --mode plan   show status only (default)
  --mode apply  enable automerge and watch
  --retry       rerun failed workflows before watch
  --dirty block fail fast if unstaged changes (default)
  --dirty allow allow release even with unstaged changes

  special circumstances only (footgun — prefer --into prod):
  --from main   skip the feature branch, release whatever is on main

  the release stamp (git.release.uses):
  apply needs the human's stamp — git.release.uses set --quant 1 — and spends
  one use at the arm of the merge; --into prod arms both prs on that one use.
  a commit grant never ships. see the stamp: rhx git.release.uses get
"
`;

exports[`git.release.p2 argument validation given: [case-arg-mode-invalid] --mode invalid value when: [t0] --mode invalid then: exit 2: shows error message 1`] = `
