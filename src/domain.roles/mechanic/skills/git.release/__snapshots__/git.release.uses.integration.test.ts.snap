exports[`git.release.uses.sh given: [case9] any actor asks for help when: [t0] --help then: the render matches snapshot 1`] = `
"usage: git.release.uses set --quant N
       git.release.uses allow | block | del | get
       git.release.uses allow | block | get --global
       git.release.uses allow | block | del | get --org <org>

commands:
  set    grant N releases on this tree (human only)
  allow  grant unlimited releases on this tree (human only)
  block  revoke (alias for del)
  del    revoke
  get    check this tree's release grant, all three levels

options:
  --quant N      number of releases to allow (or 'infinite')
  --global       the host-wide release blocker
  --org <org>    the per-org release permission
  --help, -h     show this help

examples:
  git.release.uses set --quant 1                               # stamp one release on this tree
  git.release.uses allow --org ehmpathy                        # allow releases for one org
  git.commit.uses allow && git.release.uses block              # push all day; never ship

a release = git.release --mode apply. commit, stage, rebase, and push
ride git.commit.uses; no commit grant can ship.
"
`;
