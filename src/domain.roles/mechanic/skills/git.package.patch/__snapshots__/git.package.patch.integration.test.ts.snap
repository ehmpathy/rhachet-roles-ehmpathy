exports[`git.package.patch.sh given: [case4] the dispatcher when: [t1] help is asked for then: it shows usage 1`] = `
"🐢 heres the wave...

🐚 git.package.patch
   ├─ subcommands
   │  ├─ set    open an edit dir; with --why + --upstream, seal it into a patch + note
   │  ├─ get    each patch: apply state, why, upstream, and the repair if stale
   │  ├─ del    retire a patch: its entry, its file, and its note
   │  └─ help   show this usage
   └─ examples
      ├─ rhx git.package.patch set --package rhachet --mode apply
      ├─ rhx git.package.patch set --package rhachet --why 'keep the stop hook quiet on a clean tree' --upstream https://github.com/ehmpathy/rhachet/issues/580 --mode apply
      ├─ rhx git.package.patch get
      └─ rhx git.package.patch del --package rhachet --mode apply
"
`;

