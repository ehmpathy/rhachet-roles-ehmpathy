exports[`git.branch.cutover given: [case1] a plan with two picks and a dirty tree when: [t0] begin with --mode plan (the default) then: it previews the cutover and changes naught 1`] = `
"🐢 heres the wave...

🐚 git.branch.cutover begin --mode plan
   ├─ source: turtle/wave-report @ <sha>
   ├─ base: origin/main @ <sha> (fetched)
   ├─ into: turtle/wave-report-v2 (new, no upstream)
   ├─ quota: 3 left (apply spends 1)
   ├─ picks (2, in order)
   │  ├─ 1. <sha> cont(wave): add swell height
   │  └─ 2. <sha> cont(wave): add tide window
   ├─ left behind on turtle/wave-report (1, not picked)
   │  └─ <sha> feat(wave): add wave report
   ├─ tracked edits (1) — will park, verify, and carry, unstaged
   │  └─ M readme.md
   └─ untracked (1) — untouched
      └─ ? notes.md

run with --mode apply to execute
"
`;

exports[`git.branch.cutover given: [case2] a single pick carried onto a fresh main when: [t0] begin --mode apply with one pick then: the new branch holds main plus the pick 1`] = `
