   ├─ gh auth login
   └─ rhx keyrack unlock --owner ehmpath --env prep --key EHMPATHY_SEATURTLE_GITHUB_TOKEN

cause: gh: To use GitHub CLI, please run: gh auth login
HTTP 401: Bad credentials
"
`;

