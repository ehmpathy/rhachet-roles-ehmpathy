// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`git.commit.uses precedence matrix given: [global=blocked, org=allowed, local=allowed] when: [t0] push is attempted then: blocked by global 1`] = `
"🐢 bummer dude...

🐚 git.commit.push
   └─ ✋ ConstraintError: commits blocked globally

🥥 did you know?
   ├─ a human set the global blocker; ask them to lift it
   └─ git.commit.uses allow --global
"
`;

exports[`git.commit.uses precedence matrix given: [global=unset, org=@all-blocked, local=allowed] when: [t0] push is attempted then: blocked by @all default 1`] = `
"🐢 bummer dude...

🐚 git.commit.push
   └─ ✋ ConstraintError: commits blocked for org ehmpathy (from @all)

🥥 did you know?
   ├─ a human blocked this org; ask them to allow it
   └─ git.commit.uses allow --org ehmpathy
"
`;

exports[`git.commit.uses precedence matrix given: [global=unset, org=allowed, local=allowed] when: [t0] push is attempted then: allowed - shows plan 1`] = `
"🐢 heres the wave...

🐚 git.commit.push --mode plan
   ├─ push: origin/turtle/feature
   ├─ pr
   │  ├─ title: feat: test commit
   │  ├─ action: findsert
   │  └─ opened: as-ehmpath (ehmpath keyrack)
   └─ meter
      └─ push: held → held (a push spends no use, revokes naught)

run with --mode apply to execute
"
`;

exports[`git.commit.uses precedence matrix given: [global=unset, org=allowed, local=blocked] when: [t0] push is attempted then: blocked by the revoked local grant 1`] = `
"🐢 bummer dude...

🐚 git.commit.push
   └─ ✋ ConstraintError: no commit grant held

🥥 did you know?
   ├─ a push rides the commit grant; ask your human to grant one
   └─ git.commit.uses set --quant N
"
`;

