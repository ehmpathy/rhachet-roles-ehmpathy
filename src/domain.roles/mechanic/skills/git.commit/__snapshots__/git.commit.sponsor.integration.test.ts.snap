exports[`git.commit.sponsor.sh given: [case8] --help when: [t0] --help is asked for then: leads with a .what, then the three value forms 1`] = `
"git.commit.sponsor — name the human who answers for this tree's commits

usage: printf 'Name <email>' | git.commit.sponsor set --who @stdin
       git.commit.sponsor set --who "Name <email>"
       git.commit.sponsor set --who @me
       git.commit.sponsor get
       git.commit.sponsor del

commands:
  set    bind the sponsor for this worktree (human only)
  get    read the bound sponsor
  del    clear the bound sponsor (human only)

options (set):
  --who @stdin           read 'Name <email>' from the pipe
  --who "Name <email>"   name the human as a literal
  --who @me              your own github session
                         (needs YOUR OWN 'gh auth login' on this
                          host — a cloud grove carries the clone's)
                         reserve for YOUR OWN requested work — a
                         supervisor who acts for someone else
                         should pipe THAT human via --who @stdin

options:
  --help, -h             show this help
"
`;

exports[`git.commit.sponsor.sh given: [case9] --who @me when the host cannot answer when: [t0] the gh session lookup fails then: it offers the two grove-agnostic forms 1`] = `
