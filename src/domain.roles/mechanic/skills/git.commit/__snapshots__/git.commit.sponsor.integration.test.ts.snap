exports[`git.commit.sponsor.sh given: [case8] --help when: [t0] --help is asked for then: leads with a .what, then the three value forms 1`] = `
"git.commit.sponsor — name the human who answers for this tree's commits

  on your own machine, commits need no bind: they name the human in
  this machine's git config. bind a sponsor to credit someone else,
  or on the clone's machine. a bind wins over git config.

usage: printf 'Name <email>' | git.commit.sponsor set --who @stdin
       git.commit.sponsor set --who "Name <email>"
       git.commit.sponsor set --who @self
       git.commit.sponsor get
       git.commit.sponsor del

commands:
  set    bind the sponsor for this worktree (human only, at a terminal)
  get    read the bound sponsor, or the git config default
  del    clear the bound sponsor (human only, at a terminal)

options (set):
  --who @stdin           read 'Name <email>' from the pipe
  --who "Name <email>"   name the human as a literal
  --who @self            this machine's git config user.name + user.email
                         (refuses where git config names a clone)

options:
  --help, -h             show this help
"
`;

