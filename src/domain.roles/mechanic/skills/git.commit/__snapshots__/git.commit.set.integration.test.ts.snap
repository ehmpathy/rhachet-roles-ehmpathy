exports[`git.commit.set.sh given: [case34] --help short-circuits before the identity fetch when: [t0] NODE_ENV=production would otherwise make the keyrack fetch reachable then: --help exits 0 with usage and emits no keyrack heads-up 1`] = `
"usage: echo 'header\\n\\n- body' | git.commit.set -m @stdin [--mode plan|apply] [--push] [--auth as-ehmpath|as-human]

options:
  --message, -m @stdin   read multiline commit message from stdin (required)
                         first line = header, after blank line = body
  --mode plan|apply      plan shows preview, apply executes (default: plan)
  --push                 push after commit (requires push permission)
  --auth as-ehmpath|as-human
                         who opens the pr (default: as-ehmpath)
                         as-ehmpath = seaturtle bot via ehmpath keyrack token
                         as-human   = the gh cli login (fallback on keyrack failure)
                         note: --auth governs pr-open only; the commit is always
                         authored as seaturtle[bot]. under as-human no keyrack
                         token is fetched — the commit uses the default seaturtle
                         identity, so the fallback escapes keyrack entirely
  --unstaged ignore      proceed despite unstaged changes (commit staged only)
  --unstaged include     stage all unstaged changes before commit
  --help, -h             show this help
"
`;

