exports[`git.commit.uses.sh given: [case1] set --quant N when: [t0] a grant of 3 uses then: outputs radical with the granted count and what it covers 1`] = `
"🐢 radical! let's ride!

🐚 git.commit.uses set
   ├─ granted: 3
   └─ covers: commit, stage, rebase, push

🥥 did you know?
   ├─ commits will name test-fns <test-fns@test.local>, from git config
   └─ printf 'Name <email>' | rhx git.commit.sponsor set --who @stdin
"
`;

exports[`git.commit.uses.sh given: [case2] a retired field is typed (F8) when: [t1] the render for --push then: matches snapshot 1`] = `
"🐢 bummer dude...

🐚 git.commit.uses
   └─ ✋ ConstraintError: --push is retired

🥥 did you know?
   ├─ the commit grant covers commit, stage, rebase, and push; a release rides its own meter
   ├─ git.commit.uses set --quant N     # commit + push
   └─ git.release.uses set --quant 1    # ship
"
`;

exports[`git.commit.uses.sh given: [case2b] any actor asks for help when: [t0] --help then: it names the levels and the examples, never --push 1`] = `
"usage: git.commit.uses set --quant N
       git.commit.uses allow | block | del | get

commands:
  set    grant N commits (human only)
  del    revoke the grant; push stops too
  block  alias for del
  allow  grant unlimited commits
  get    check the grant

options (set):
  --quant N             number of commits to allow (or 'infinite')

options:
  --global              the host-wide commit blocker
  --org <org>           the per-org commit permission
  --help, -h            show this help

examples:
  git.commit.uses set --quant 3                          # three commits; push rides them
  git.commit.uses allow && git.release.uses block        # push all day; never ship
  git.commit.uses set --quant 0                          # commit no more; push stays
  git.commit.uses block                                  # revoke; push stops too

the grant covers commit, stage, rebase, and push to this tree's branch.
a push spends no use, and works at 0 left until a human revokes.
no commit grant can ship: a release needs git.release.uses.
"
`;

