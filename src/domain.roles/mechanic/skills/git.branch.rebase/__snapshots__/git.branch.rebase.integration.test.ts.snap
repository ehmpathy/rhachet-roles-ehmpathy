   ├─ usage
   │  └─ rhx git.branch.rebase abort [--unstaged ignore]
   ├─ args
   │  └─ --unstaged ignore    set a fresh unstaged edit aside too; put back after
   └─ examples
      ├─ rhx git.branch.rebase abort
      └─ rhx git.branch.rebase abort --unstaged ignore
"
`;

