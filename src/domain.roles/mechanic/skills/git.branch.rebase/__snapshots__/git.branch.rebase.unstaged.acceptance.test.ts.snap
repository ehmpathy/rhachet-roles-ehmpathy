exports[`git.branch.rebase --unstaged (acceptance, built skill) given: [journey13] each subcommand asked for --help when: [t0] begin --help then: the built skill answers with its own usage, exit 0 1`] = `
"🐢 heres the wave...

🐚 git.branch.rebase begin
   ├─ what
   │  └─ rebase this branch onto origin/main
   ├─ usage
   │  └─ rhx git.branch.rebase begin [--mode plan|apply] [--unstaged ignore|include]
   ├─ args
   │  ├─ --mode plan          preview what will be rebased (default)
   │  ├─ --mode apply         execute the rebase
   │  ├─ --unstaged ignore    set unstaged paths aside, rebase, put them back; continue or abort puts them back after a stop
   │  └─ --unstaged include   refused when unstaged edits exist: a rebase has no commit to fold them into; commit them first via git.commit.set --unstaged include
   ├─ note
   │  └─ on a tree with no unstaged edits, either --unstaged value is a no-op
   └─ examples
      ├─ rhx git.branch.rebase begin --mode plan
      └─ rhx git.branch.rebase begin --mode apply --unstaged ignore
"
`;

exports[`git.branch.rebase --unstaged (acceptance, built skill) given: [journey13] each subcommand asked for --help when: [t1] continue --help then: the built skill answers with its own usage, exit 0 1`] = `
"🐢 heres the wave...

🐚 git.branch.rebase continue
   ├─ what
   │  ├─ continue a rebase once its conflicts are settled
   │  └─ once the rebase completes, puts back any paths set aside
   ├─ usage
   │  └─ rhx git.branch.rebase continue [--unstaged ignore]
   ├─ args
   │  └─ --unstaged ignore    set a fresh unstaged edit aside too; put back after
   └─ examples
      ├─ rhx git.branch.rebase continue
      └─ rhx git.branch.rebase continue --unstaged ignore
"
`;

exports[`git.branch.rebase --unstaged (acceptance, built skill) given: [journey13] each subcommand asked for --help when: [t2] take --help then: the built skill answers with its own usage, exit 0 1`] = `
"🐢 heres the wave...

🐚 git.branch.rebase take
   ├─ what
   │  └─ settle conflicts by the side you name, then stage the files
   ├─ usage
   │  └─ rhx git.branch.rebase take --whos ours|theirs <paths...>
   ├─ args
   │  ├─ --whos    ours (your commit) | theirs (main), required
   │  └─ paths     file paths or globs, use . for all (required)
   └─ examples
      ├─ rhx git.branch.rebase take --whos theirs pnpm-lock.yaml
      ├─ rhx git.branch.rebase take --whos ours .eslintrc.json
      └─ rhx git.branch.rebase take --whos theirs .
"
`;

