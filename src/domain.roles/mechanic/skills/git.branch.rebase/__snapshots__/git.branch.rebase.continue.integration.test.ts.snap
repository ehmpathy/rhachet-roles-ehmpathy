exports[`git.branch.rebase.continue given: [case1] no rebase in progress when: [t0] attempt continue then: shows error: no rebase in progress 1`] = `
"🐢 hold up dude...

🐚 git.branch.rebase continue
   └─ ✋ ConstraintError: no rebase in progress

🥥 did you know?
   ├─ start one first
   └─ rhx git.branch.rebase begin --mode apply
"
`;

exports[`git.branch.rebase.continue given: [case1] no rebase in progress when: [t1] attempt continue while a cutover is in flight then: names the cutover verbs that own the halt 1`] = `
"🐢 hold up dude...

🐚 git.branch.rebase continue
   └─ ✋ ConstraintError: no rebase in progress
      └─ a cutover is in flight here, not a rebase

🥥 did you know?
   ├─ settle the cutover with its own verb: continue once the files are staged, or abort it whole
   ├─ rhx git.branch.cutover continue
   └─ rhx git.branch.cutover abort
"
`;

