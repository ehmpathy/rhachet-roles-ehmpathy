exports[`git.branch.rebase.begin given: [case10] uses spent, push allowed, director detection answers none when: [t0] apply mode then: refuses on uses, and names the human grant 1`] = `
"🐢 hold up dude...

🐚 git.branch.rebase begin
   └─ error: no commit uses left

ask your human to grant more:
  $ rhx git.commit.uses set --quant N --push allow
"
`;

exports[`git.branch.rebase.begin given: [case11] the pull fails and leaves no rebase in progress (a pre-rebase hook refuses) when: [t0] apply mode then: it reports the failure, never a clean rebase 1`] = `
"🐢 hold up dude...

🐚 git.branch.rebase begin --mode apply
   ├─ error: rebase failed
   └─ git.output
      ├─
      │
      │  From <tempdir>/origin
      │   * branch            main       -> FETCH_HEAD
      │  pre-rebase: refused
      │  fatal: The pre-rebase hook refused to rebase.
      │
      └─
"
`;

