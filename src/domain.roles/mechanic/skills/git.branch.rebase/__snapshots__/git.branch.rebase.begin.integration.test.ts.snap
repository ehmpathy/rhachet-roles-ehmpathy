`;

exports[`git.branch.rebase.begin given: [case7] branch already up to date when: [t0] attempt rebase with zero commits ahead then: says there is no commit to rebase 1`] = `
"🐢 already up to date

🐚 git.branch.rebase begin
   └─ no commits to rebase
"
`;

exports[`git.branch.rebase.begin given: [case7] branch already up to date when: [t1] attempt rebase with commits ahead and zero behind then: shows up to date, with one count per line 1`] = `
"🐢 already up to date

🐚 git.branch.rebase begin
   ├─ commits: 2 (ahead)
   └─ behind: 0

no rebase needed, ready to push
"
`;

exports[`git.branch.rebase.begin given: [case8] rebase already in progress when: [t0] attempt rebase then: shows in progress error with guidance 1`] = `
"🐢 hold up dude...

🐚 git.branch.rebase begin
   └─ error: rebase already in progress

to continue: rhx git.branch.rebase continue
to abort:    rhx git.branch.rebase abort
"
`;

