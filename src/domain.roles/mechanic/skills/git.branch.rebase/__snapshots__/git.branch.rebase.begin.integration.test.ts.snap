exports[`git.branch.rebase.begin given: [case11] zero commits ahead, main moved forward, a real origin when: [t0] plan mode then: previews a fast-forward 1`] = `
"🐢 heres the wave...

🐚 git.branch.rebase begin --mode plan
   ├─ rebase
   │  ├─ target: origin/main
   │  ├─ shape: fast-forward
   │  ├─ ahead: 0 commits
   │  └─ behind: 2 commits
   │     ├─ <sha> chore: commit behind 1
   │     └─ <sha> chore: commit behind 0
   └─ meter
      ├─ rebase: spends no use; the held grant suffices
      └─ push: held

run with --mode apply to execute
"
`;

