// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`git.branch.rebase.begin given: [case1] feature branch with commits ahead and behind when: [t0] plan mode (default) then: shows the preview: ahead, behind, and the meter 1`] = `
"🐢 heres the wave...

🐚 git.branch.rebase begin --mode plan
   ├─ rebase
   │  ├─ target: origin/main
   │  ├─ ahead: 3 commits
   │  │  ├─ <sha> fix(api): feature commit 2
   │  │  ├─ <sha> fix(api): feature commit 1
   │  │  ├─ <sha> fix(api): feature commit 0
   │  └─ behind: 2 commits
   │     ├─ <sha> chore: commit behind 1
   │     └─ <sha> chore: commit behind 0
   └─ meter
      ├─ commits: allowed
      └─ push: allowed

run with --mode apply to execute
"
`;

exports[`git.branch.rebase.begin given: [case2] feature branch one commit behind origin/main when: [t0] apply mode attempts rebase then: rebases onto origin/main and shows the result 1`] = `
"🐢 righteous!

🐚 git.branch.rebase begin --mode apply
   ├─ rebase
   │  ├─ target: origin/main
   │  ├─ commits: 2 ✓
   │  └─ status: clean
   └─ git.output
      ├─
      │
      │  From <tempdir>/.origin
      │   * branch            main       -> FETCH_HEAD
      │  Rebasing (1/2)
      │  Rebasing (2/2)
      │  Successfully rebased and updated refs/heads/feature/test-branch.
      │
      └─

🌊 ready to push
   └─ rhx git.commit.push
"
`;

exports[`git.branch.rebase.begin given: [case3] rebase with conflicts when: [t0] apply mode hits conflict then: shows conflict status and files 1`] = `
"🐢 hang tight...

🐚 git.branch.rebase begin --mode apply
   ├─ rebase
   │  ├─ target: origin/main
   │  ├─ commits: 3
   │  └─ status: conflict
   ├─ conflict
   │  ├─ commit: <sha> fix: add conflict file
   │  └─ files
   │     └─ conflict.txt
   ├─ next steps
   │  ├─ settle conflicts in files above
   │  └─ rhx git.branch.rebase continue
   └─ git.output
      ├─
      │
      │  From <tempdir>/.origin
      │   * branch            main       -> FETCH_HEAD
      │  Rebasing (1/3)
      │  Rebasing (2/3)
      │  Rebasing (3/3)
      │  Auto-merging conflict.txt
      │  CONFLICT (add/add): Merge conflict in conflict.txt
      │  error: could not apply <sha>... fix: add conflict file
      │  hint: Resolve all conflicts manually, mark them as resolved with
      │  hint: "git add/rm <conflicted_files>", then run "git rebase --continue".
      │  hint: You can instead skip this commit: run "git rebase --skip".
      │  hint: To abort and get back to the state before "git rebase", run "git rebase --abort".
      │  Could not apply <sha>... fix: add conflict file
      │
      └─
"
`;

exports[`git.branch.rebase.begin given: [case4] no push permission granted when: [t0] attempt rebase then: shows error: push permission required 1`] = `
"🐢 hold up dude...

🐚 git.branch.rebase begin
   └─ error: rebase requires push permission

ask your human to grant permission:
  $ rhx git.commit.uses set --quant N --push allow
"
`;

exports[`git.branch.rebase.begin given: [case5] on main branch when: [t0] attempt rebase then: shows error: cannot rebase main 1`] = `
"🐢 hold up dude...

🐚 git.branch.rebase begin
   └─ error: cannot rebase main/master
"
`;

exports[`git.branch.rebase.begin given: [case6] dirty work tree when: [t0] attempt rebase then: shows error: unstaged changes 1`] = `
