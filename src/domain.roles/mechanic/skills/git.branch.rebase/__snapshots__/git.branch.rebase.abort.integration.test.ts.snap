// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`git.branch.rebase.abort given: [case1] no rebase in progress when: [t0] attempt abort then: shows error: no rebase in progress 1`] = `
"🐢 hold up dude...

🐚 git.branch.rebase abort
   └─ ✋ ConstraintError: no rebase in progress
"
`;

exports[`git.branch.rebase.abort given: [case2] rebase in progress when: [t0] abort rebase then: shows result (simulated rebase state in test) 1`] = `
"🐢 bummer dude...

🐚 git.branch.rebase abort
   ├─ 💥 MalfunctionError: abort failed
   └─ git.output
      ├─
      │
      │  <git diagnostic about abc123def456>
      │
      └─

🥥 did you know?
   ├─ once git.output's cause is cleared, retry
   └─ rhx git.branch.rebase abort
"
`;
