// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`sessionstart.notify-permissions.sh (acceptance) given: [case1] a linked repo whose settings pre-approve three heads when: [t0] a session starts then: the pre-approved section matches snapshot 1`] = `
"
🐢 shell yeah, your guardrails are set 🌊

🐚 pre-approved bash permissions
   ├─ 4 commands pre-approved, across 3 heads — no permission prompt for any of them
   ├─ heads
   │  ├─ git (2)
   │  ├─ rhx (1)
   │  └─ tree (1)
   ├─ see them all, on demand
   │  ├─ rhx permissions.get                     every pre-approved command, grouped by head
   │  ├─ rhx permissions.get --head <head>       one head: pre-approved + paved alternatives
   │  └─ rhx permissions.get --for '<command>'   one command: verdict + every candidate, ranked
   │
   └─ a bash command NOT pre-approved blocks and asks you to reconsider — check first, to minimize interruptions

"
`;

