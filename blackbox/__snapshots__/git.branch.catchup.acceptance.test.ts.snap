// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`git.branch.catchup, via rhachet given: [case1] a repo with the mechanic role linked, on its default branch when: [t0] the verb is asked for help then: matches snapshot 1`] = `
"🐢 heres the wave...

🐚 git.branch.catchup
   ├─ catch up via merge (no rewrite) from origin/main
   ├─ one merge commit of origin/main into this branch; the push after it is plain
   ├─ when: use it once the branch is pushed; rebase before the first push
   ├─ subcommands
   │  ├─ begin      preview (default) or apply the merge
   │  ├─ take       settle a conflict by side: --whos <main|branch>
   │  ├─ lock       refresh a taken lockfile against the merged package.json
   │  ├─ continue   make the merge commit once every conflict is settled
   │  ├─ abort      back out to the state before begin
   │  └─ help       show this usage
   └─ examples
      ├─ rhx git.branch.catchup begin
      ├─ rhx git.branch.catchup begin --mode apply
      ├─ rhx git.branch.catchup take --whos main pnpm-lock.yaml
      ├─ rhx git.branch.catchup lock refresh
      ├─ rhx git.branch.catchup continue
      ├─ rhx git.branch.catchup abort
      └─ then: rhx git.commit.push --mode apply
"
`;

exports[`git.branch.catchup, via rhachet given: [case1] a repo with the mechanic role linked, on its default branch when: [t1] begin, plan mode, on the default branch then: matches snapshot 1`] = `
"✋ ConstraintError: will not merge into main

🐚 git.branch.catchup begin --mode plan
   ├─ branch: main
   ├─ why: this verb levels a feature branch with main; it never writes to main or master
   └─ fix: run it from the worktree of your feature branch
"
`;

exports[`git.branch.catchup, via rhachet given: [case1] a repo with the mechanic role linked, on its default branch when: [t2] continue, with no merge in flight then: matches snapshot 1`] = `
"✋ ConstraintError: no merge in flight

🐚 git.branch.catchup continue
   ├─ state: no catch-up merge is in flight
   └─ fix: start one with rhx git.branch.catchup begin
"
`;

