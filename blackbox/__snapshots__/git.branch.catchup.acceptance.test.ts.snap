exports[`git.branch.catchup, via rhachet given: [case5] a pushed branch whose pnpm lockfile conflicts with main when: [t0] begin --mode apply then: matches snapshot 1`] = `
"✋ ConstraintError: merge stopped on conflicts

🐚 git.branch.catchup begin --mode apply
   ├─ merge
   │  ├─ from: origin/main
   │  └─ status: in flight, unsettled
   ├─ conflicts
   │  └─ pnpm-lock.yaml
   └─ next
      ├─ a lockfile is refreshed, not merged
      │  ├─ rhx git.branch.catchup take --whos main pnpm-lock.yaml
      │  └─ rhx git.branch.catchup lock refresh
      ├─ or take a side:    rhx git.branch.catchup take --whos <main|branch> <file>
      ├─ then:              rhx git.branch.catchup continue
      └─ or back out:       rhx git.branch.catchup abort
"
`;

