exports[`git.branch.catchup, via rhachet given: [case3] a pushed branch that conflicts with main on one file when: [t0] begin --mode apply then: matches snapshot 1`] = `
"✋ ConstraintError: merge stopped on conflicts

🐚 git.branch.catchup begin --mode apply
   ├─ merge
   │  ├─ from: origin/main
   │  └─ status: in flight, unsettled
   ├─ conflicts
   │  └─ src/spot.md
   └─ next
      ├─ remove the <<<<<<< ======= >>>>>>> lines from each file
      ├─ settle each file:  rhx git.stage.add <file>
      ├─ or take a side:    rhx git.branch.catchup take --whos <main|branch> <file>
      ├─ then:              rhx git.branch.catchup continue
      └─ or back out:       rhx git.branch.catchup abort
"
`;

exports[`git.branch.catchup, via rhachet given: [case3] a pushed branch that conflicts with main on one file when: [t1] take --whos main src/spot.md then: matches snapshot 1`] = `
