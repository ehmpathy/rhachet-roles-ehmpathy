exports[`git.pull.title and git.pull.description, via rhachet given: [case1] a repo with the mechanic role linked when: [t0] each verb is asked for --help then: each help is snapped 1`] = `
{
  "descGet": "usage: git.pull.description.get [--which <n>] [--in <owner/name>] [--auth as-ehmpath|as-human] [--output tree|json|text] [--into <path>]

options:
  --which <n>                  the pull request (default: the open pull of the cwd branch)
  --in <owner/name>            the repo (default: the cwd's github origin); a home org only
  --auth as-ehmpath|as-human   who reads (default: as-ehmpath)
  --output tree|json|text      the output shape (default: tree); text = the body alone.
                               via rhx, stdout opens with rhx's header lines: for json parse
                               from the first {; to edit the body, use --into
  --into <path>                also write the bare body into <path>, for you to edit and pass to
                               set --from <path>. <path> must sit inside this repo, untracked by git
  --help, -h                   show this help

example:
  rhx git.pull.description get --into ./.temp/body.md
  rhx git.pull.description set --from ./.temp/body.md
",
  "descSet": "usage: git.pull.description.set --from <path|@stdin> [--which <n>] [--in <owner/name>] [--mode plan|apply] [--auth as-ehmpath|as-human] [--output tree|json]

options:
  --from <path|@stdin>         the body; written with the seaturtle attribution as its last line
  --which <n>                  the pull request (default: the open pull of the cwd branch)
  --in <owner/name>            the repo (default: the cwd's github origin); a home org only
  --mode plan|apply            plan shows preview, apply writes and reads back (default: plan)
  --auth as-ehmpath|as-human   who writes (default: as-ehmpath)
  --output tree|json           the output shape (default: tree)
  --help, -h                   show this help

example:
  rhx git.pull.description get --into ./.temp/body.md
  rhx git.pull.description set --from ./.temp/body.md --mode apply
",
  "titleGet": "usage: git.pull.title.get [--which <n>] [--in <owner/name>] [--auth as-ehmpath|as-human] [--output tree|json|text] [--into <path>]

options:
  --which <n>                  the pull request (default: the open pull of the cwd branch)
  --in <owner/name>            the repo (default: the cwd's github origin); a home org only
  --auth as-ehmpath|as-human   who reads (default: as-ehmpath)
  --output tree|json|text      the output shape (default: tree). via rhx, stdout opens with
                               rhx's header lines: for text (the title alone) read the last
                               line; for json parse from the first {; to edit it, use --into
  --into <path>                also write the bare title into <path>, for you to edit and pass to
                               set --from <path>. <path> must sit inside this repo, untracked by git
  --help, -h                   show this help

example:
  rhx git.pull.title get --into ./.temp/title.md
  rhx git.pull.title set --from ./.temp/title.md
",
  "titleSet": "usage: git.pull.title.set --from <path|@stdin> [--which <n>] [--in <owner/name>] [--mode plan|apply] [--auth as-ehmpath|as-human] [--output tree|json]

options:
  --from <path|@stdin>         the new title, one line; from a file, or piped in
  --which <n>                  the pull request (default: the open pull of the cwd branch)
  --in <owner/name>            the repo (default: the cwd's github origin); a home org only
  --mode plan|apply            plan shows preview, apply writes and reads back (default: plan)
  --auth as-ehmpath|as-human   who writes (default: as-ehmpath)
  --output tree|json           the output shape (default: tree)
  --help, -h                   show this help

example:
  rhx git.pull.title get --into ./.temp/title.md
  rhx git.pull.title set --from ./.temp/title.md --mode apply
  echo 'feat(reef): map the kelp beds' | rhx git.pull.title set --from @stdin --mode apply
",
}
`;

exports[`git.pull.title and git.pull.description, via rhachet given: [case1] a repo with the mechanic role linked when: [t1] the dispatchers are called with a spaced verb, or none then: no verb refuses with exit 2 and names the verbs 1`] = `
"✋ ConstraintError: a verb is required; the verbs are get | set

🥥 did you know?
   └─ to fix it
      └─ rhx git.pull.description get --help
"
`;

exports[`git.pull.title and git.pull.description, via rhachet given: [case1] a repo with the mechanic role linked when: [t2] description set is piped a body of attribution lines alone then: stdin reaches the verb: it is read, stripped, and refused as wordless 1`] = `
