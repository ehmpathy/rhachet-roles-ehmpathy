exports[`git.branch.cutover (acceptance) given: [case1] a repo with the mechanic role linked when: [t0] the caller asks for help then: the usage renders, at exit 0, with each subcommand 1`] = `
"
🪨 run solid skill repo=ehmpathy/role=mechanic/skill=git.branch.cutover

🐢 heres the wave...

🐚 git.branch.cutover
   ├─ subcommands
   │  ├─ begin      cut a fresh branch here and carry the work onto it
   │  ├─ continue   continue after a conflict is settled
   │  ├─ abort      undo the whole cutover
   │  └─ help       show this usage
   └─ examples
      ├─ rhx git.branch.cutover begin --from @main --into turtle/wave-report-v2 --pick a1b2c3d
      ├─ rhx git.branch.cutover begin --from @main --into turtle/wave-report-v2 --pick a1b2c3d --mode apply
      ├─ rhx git.branch.cutover begin --from @tree --into turtle/reef-shoals --mode apply
      ├─ rhx git.branch.cutover continue
      ├─ rhx git.branch.cutover abort
      └─ every flag of a subcommand: rhx git.branch.cutover begin --help
"
`;

exports[`git.branch.cutover (acceptance) given: [case1] a repo with the mechanic role linked when: [t1] the caller continues with no cutover in flight then: it reaches the continue guard, not the dispatcher 1`] = `
