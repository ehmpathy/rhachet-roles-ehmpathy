exports[`git.branch.cutover (acceptance) given: [case2] a stale branch whose work must ride onto fresh main when: [t0] the caller previews the cutover, with a tracked edit then: the plan names base, picks, and the edit, and changes naught 1`] = `
"
🪨 run solid skill repo=ehmpathy/role=mechanic/skill=git.branch.cutover

🐢 heres the wave...

🐚 git.branch.cutover begin --mode plan
   ├─ source: turtle/wave-report @ <sha>
   ├─ base: origin/main @ <sha> (fetched)
   ├─ into: turtle/wave-report-v2 (new, no upstream)
   ├─ quota: 5 left (apply spends 1)
   ├─ picks (2, in order)
   │  ├─ 1. <sha> feat(wave): add wave report
   │  └─ 2. <sha> cont(wave): add tide window
   ├─ left behind on turtle/wave-report (1, not picked)
   │  └─ <sha> cont(wave): add band of swell
   └─ tracked edits (1) — will park, verify, and carry, unstaged
      └─ M src/wave.ts

run with --mode apply to execute
"
`;

exports[`git.branch.cutover (acceptance) given: [case2] a stale branch whose work must ride onto fresh main when: [t1] the caller applies it then: the report matches its snapshot 1`] = `
"
🪨 run solid skill repo=ehmpathy/role=mechanic/skill=git.branch.cutover

🐢 righteous!

🐚 git.branch.cutover begin --mode apply
   ├─ source: turtle/wave-report @ <sha> (untouched)
   ├─ base: origin/main @ <sha>
   ├─ into: turtle/wave-report-v2 (checked out, no upstream)
   ├─ picks (2, in order)
   │  ├─ 1. <sha> → <sha> feat(wave): add wave report ✓
   │  └─ 2. <sha> → <sha> cont(wave): add tide window ✓
   ├─ left behind on turtle/wave-report (1, not picked)
   │  └─ <sha> cont(wave): add band of swell
   ├─ tracked edits (1) ✓ parked, verified, carried, unstaged
   │  └─ M src/wave.ts
   ├─ quota: 1 spent, 4 left
   └─ commit level: set by "feat(wave): add wave report" — the next commit leads with cont:

🥥 did you know?
   ├─ the new branch lives here alone; commit, then push it when ready
   ├─ printf 'cont(scope): ...' | rhx git.commit.set -m @stdin --mode apply
   └─ rhx git.commit.push --mode apply
"
`;

exports[`git.branch.cutover (acceptance) given: [case3] a pick that conflicts with main when: [t0] the caller applies a cutover that picks the conflicted commit then: it halts at exit 2 and names the file, continue, and abort 1`] = `
"
🪨 run solid skill repo=ehmpathy/role=mechanic/skill=git.branch.cutover

🐢 hang tight...

🐚 git.branch.cutover begin --mode apply
   └─ ✋ ConstraintError: halted: a pick conflicts
      ├─ into: turtle/wave-report-v2 (checked out, no upstream)
      ├─ picks (1, in order)
      │  └─ 1. <sha> ✋ conflict
      ├─ conflict
      │  ├─ commit: <sha> cont(wave): add band of swell
      │  └─ files
      │     └─ src/band.ts (both added it)
      ├─ stage: ✋ no live commit grant, so rhx git.stage.add will refuse
      │  └─ ask your human: rhx git.commit.uses set --quant N
      └─ quota: the cutover unit is spent; abort refunds none

🥥 did you know?
   ├─ settle the files above; once your human grants a commit (see stage: above), stage them, then continue — or undo the whole cutover
   ├─ rhx git.stage.add <files>
   ├─ rhx git.branch.cutover continue
   └─ rhx git.branch.cutover abort
"
`;

exports[`git.branch.cutover (acceptance) given: [case3] a pick that conflicts with main when: [t1] the caller continues before the settle then: it refuses and names the file still in conflict 1`] = `
"
🪨 run solid skill repo=ehmpathy/role=mechanic/skill=git.branch.cutover

🐢 bummer dude...

🐚 git.branch.cutover
   └─ ✋ ConstraintError: files are still in conflict
      ├─ files
      │  └─ src/band.ts (both added it)
      ├─ stage: ✋ no live commit grant, so rhx git.stage.add will refuse
      │  └─ ask your human: rhx git.commit.uses set --quant N
      └─ fix: settle each; once your human grants a commit, rhx git.stage.add <files>, then continue again
"
`;

exports[`git.branch.cutover (acceptance) given: [case3] a pick that conflicts with main when: [t2] the caller settles, stages, and continues then: the cutover finishes with the settled pick on top of main 1`] = `
"
🪨 run solid skill repo=ehmpathy/role=mechanic/skill=git.branch.cutover

🐢 righteous!

🐚 git.branch.cutover continue
   ├─ source: turtle/wave-report @ <sha> (untouched)
   ├─ base: origin/main @ <sha>
   ├─ into: turtle/wave-report-v2 (checked out, no upstream)
   ├─ picks (1, in order)
