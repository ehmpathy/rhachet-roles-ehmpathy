exports[`git.pull.watch, via rhachet given: [case1] a repo with the mechanic role linked when: [t0] each verb is asked for --help then: each help is snapped 1`] = `
{
  "del": "usage: git.pull.watch del --pull <n> [--in <owner/name>] [--mode plan|apply] [--output tree|json]
needs: an enrolled clone (rhx enroll sets RHACHET_CLONE_SERIAL)

options:
  --pull <n>          the pull request whose watch to stop (required)
  --in <owner/name>   the repo (default: the cwd's github origin)
  --mode plan|apply   plan shows what would happen; apply deletes (default: plan)
  --output tree|json  the output shape (default: tree)
  --help, -h          show this help

example:
  rhx git.pull.watch del --pull 1220 --mode apply
",
  "get": "usage: git.pull.watch get [--output tree|json]

options:
  --output tree|json  the output shape (default: tree)
  --help, -h          show this help

example:
  rhx git.pull.watch get
",
  "set": "usage: git.pull.watch set --pull <n> [--in <owner/name>] [--mode plan|apply] [--output tree|json]
needs: an enrolled clone (rhx enroll sets RHACHET_CLONE_SERIAL)

options:
  --pull <n>          the pull request to watch (required)
  --in <owner/name>   the repo (default: the cwd's github origin)
  --mode plan|apply   plan shows what would happen; apply watches (default: plan)
  --output tree|json  the output shape (default: tree)
  --help, -h          show this help

example:
  rhx git.pull.watch set --pull 1220 --mode apply
",
}
`;

