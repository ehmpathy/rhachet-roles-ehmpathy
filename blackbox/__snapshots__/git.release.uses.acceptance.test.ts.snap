exports[`git.release.uses (acceptance) given: [case1] a linked repo that names its org when: [t0] any actor runs \`rhx git.release.uses get\` then: the shipped skill reads all three levels as blocked 1`] = `
"🐢 let's check the release meter...

🐚 git.release.uses get
   ├─ local: unset (blocked)
   ├─ org: blocked — no org config for ehmpathy
   ├─ global: not blocked
   └─ verdict: blocked by local + org

🥥 did you know?
   ├─ a human lifts a level from their own terminal; one command per level that blocks
   ├─ rhx git.release.uses set --quant 1
   └─ rhx git.release.uses allow --org ehmpathy
"
`;

