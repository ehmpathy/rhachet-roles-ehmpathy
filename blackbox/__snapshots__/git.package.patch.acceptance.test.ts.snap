exports[`git.package.patch (acceptance) given: [case1] a linked repo with is-number@7.0.0 on disk when: [t0] the crew runs \`rhx git.package.patch begin --package is-number\` then: rhachet finds the verb, and begin plans the edit dir, exit 0 1`] = `
"
🪨 run solid skill repo=ehmpathy/role=mechanic/skill=git.package.patch

🐢 heres the wave...

🐚 git.package.patch begin
   ├─ package: is-number@7.0.0
   ├─ prior patch: none
   ├─ would open edit dir: node_modules/.pnpm_patches/is-number@7.0.0
   └─ mode: plan (naught changed)

🥥 did you know?
   ├─ rerun with --mode apply to open it
   └─ rhx git.package.patch begin --package is-number@7.0.0 --mode apply
"
`;

exports[`git.package.patch (acceptance) given: [case1] a linked repo with is-number@7.0.0 on disk when: [t1.1] the crew runs commit with no --upstream then: it is refused as a constraint, exit 2, on both streams 1`] = `
"
🪨 run solid skill repo=ehmpathy/role=mechanic/skill=git.package.patch

🐢 bummer dude...

🐚 git.package.patch commit
   └─ ✋ ConstraintError: --upstream is required

🥥 did you know?
   ├─ add --upstream '<issue-url>' — an issue or pr url where the real fix is queued
   └─ rhx git.package.patch commit --package is-number --why 'reef fix: treat a numeric string with whitespace as not a number' --upstream '<issue-url>' --mode apply
"
`;

