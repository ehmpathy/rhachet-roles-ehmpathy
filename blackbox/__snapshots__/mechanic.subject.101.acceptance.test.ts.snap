exports[`mechanic subject.101 given: [case1] a repo with role=mechanic linked from the package when: [t1] the maintainer costs --subject 101 then: the readout a maintainer reads matches the snapshot 1`] = `
"🧢 roles cost --repo ehmpathy --role mechanic --subject 101
   ├─ tokens  = <n> (full emitted payload, o200k_base)
   ├─ budget  = 30,000 tokens (<pct>% used)
   ├─ batches = 35 say · 2 ref
   ├─ chrome  = <n> tokens (<pct>%) — stats blocks, xml, join seams
   │
   └─ where the tokens go
      └─ <n>  <pct>%  … <n> more

   .note = the column plus chrome is the total. chrome is the renderer's own floor —
           no edit to a say or ref entry reaches it."
`;

exports[`mechanic subject.101 given: [case1] a repo with role=mechanic linked from the package when: [t2] a cure in that seat writes to /tmp then: a shell write to /tmp is blocked too, with exit 2 1`] = `
"✋ ConstraintError: Bash write to /tmp

use .temp/ instead:

  echo "data" > .temp/scratch.txt

/tmp is not temporary - it persists and never auto-cleans.
.temp/ is scoped to this repo and gitignored."
`;

