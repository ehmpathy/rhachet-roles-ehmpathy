// Jest Snapshot v1, https://jestjs.io/docs/snapshot-testing

exports[`test.acceptance.prebuilt.sh given: [case1] a repo with a built dist/ when: [t0] the crew runs it with --scope and --resnap then: the argv carries the config, the update flag, and the scope 1`] = `
