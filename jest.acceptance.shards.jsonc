{
  // explicit shards run specific test patterns in their own shard
  // this enables parallelism for slow test files
  // .note = the slow guardBorder.onWebfetch suites call a live brain, so they sit outside the
  //         default testMatch and run in the test-evaluation job; no explicit shard is owed here
  "explicit": [],

  // dynamic shards split the rest of tests (not in explicit patterns)
  "dynamic": {
    "shards": 1
  }
}
