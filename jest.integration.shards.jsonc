{
  // explicit shards run specific test patterns in their own shard
  // add tests here if they take 60+ seconds on their own
  "explicit": [
    // .note = live-brain suites (e.g. imagineIsContentAdmissible) sit outside the default testMatch;
    //         they run in the test-evaluation job, so an explicit shard here would match no test
    { "patterns": ["src/domain.roles/librarian/skills/brief.condense/brief.condense.integration.test.ts"] },
    // .note = isolated to own shard after CI hang investigation: cases 18/19 have skipIf(CI) guards
    //         but shard 4/5 still hung for 6+ hours. isolate to determine if this file is the cause.
    { "patterns": ["src/domain.roles/mechanic/skills/git.repo.test/git.repo.test.play.integration.test.ts"] }
  ],

  // dynamic shards split all tests evenly
  "dynamic": {
    "shards": 5
  }
}
